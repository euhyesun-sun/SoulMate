rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'photoURL', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 500 &&
             data.createdAt == request.time;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'mood', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 5 &&
             data.userId == request.auth.uid &&
             data.mood is string && data.mood.size() <= 32 &&
             data.status in ['active', 'completed'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'content', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.role in ['user', 'assistant'] &&
             data.content is string && data.content.size() <= 4096 &&
             data.createdAt == request.time;
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && 
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) &&
                      incoming().displayName is string && incoming().displayName.size() <= 100 &&
                      incoming().photoURL is string && incoming().photoURL.size() <= 500;
    }

    match /sessions/{sessionId} {
      allow get: if isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidId(sessionId) && isValidSession(incoming());
      
      allow update: if isOwner(existing().userId) && 
                      isValidSession(incoming()) && (
                        // Action: Complete session
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
                      );
      
      match /messages/{messageId} {
        function sessionOwner() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId;
        }

        allow list, get: if isSignedIn() && isOwner(get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId);
        
        allow create: if isSignedIn() && isOwner(sessionOwner()) && isValidId(messageId) && isValidMessage(incoming());
      }
    }
  }
}
